// Native SIMD-accelerated provider for Mesh client content encryption,
// backed by the reusable crypto/native (libsodium) package.
#scope_module
Native :: #import "crypto/native";

#scope_export
Initialize :: () -> bool { return Native.Initialize() }
Clear :: (bytes: []u8) { Native.Clear(bytes) }
RandomBytes :: (bytes: []u8) -> bool { return Native.RandomBytes(bytes) }
Digest :: (input: []u8, output: []u8) -> bool { return Native.Sha256(input, output) }
HmacSha256 :: (input: []u8, key: []u8, output: []u8) -> bool { return Native.HmacSha256(input, key, output) }
Seal :: (input: []u8, aad: []u8, key: []u8, nonce: []u8, output: []u8) -> s64 {
    return Native.XChaCha20Poly1305Seal(input, aad, key, nonce, output)
}
Open :: (sealed: []u8, aad: []u8, key: []u8, nonce: []u8, output: []u8) -> s64 {
    return Native.XChaCha20Poly1305Open(sealed, aad, key, nonce, output)
}
SealChaCha :: (input: []u8, aad: []u8, key: []u8, nonce: []u8, output: []u8) -> s64 {
    return Native.ChaCha20Poly1305Seal(input, aad, key, nonce, output)
}
OpenChaCha :: (sealed: []u8, aad: []u8, key: []u8, nonce: []u8, output: []u8) -> s64 {
    return Native.ChaCha20Poly1305Open(sealed, aad, key, nonce, output)
}
DigestStateBytes :: () -> usize { return Native.DigestStateBytes() }
DigestStart :: (state: []u8) -> bool { return Native.DigestStart(state) }
DigestUpdate :: (state: []u8, input: []u8) -> bool { return Native.DigestUpdate(state, input) }
DigestFinish :: (state: []u8, output: []u8) -> bool { return Native.DigestFinish(state, output) }
DerivePassword :: (password: []u8, salt: []u8, output: []u8, operations: u64, memory: usize) -> bool {
    if output.count != 32 {
        Native.Clear(output)
        return false
    }
    return Native.Argon2id(password, salt, output, operations, memory)
}
DevicePublic :: (seed: []u8, output: []u8) -> bool { return Native.Ed25519Public(seed, output) }
SignDevice :: (seed: []u8, input: []u8, output: []u8) -> bool { return Native.Ed25519Sign(seed, input, output) }
VerifyDevice :: (public_key: []u8, input: []u8, signature: []u8) -> bool {
    return Native.Ed25519Verify(public_key, input, signature)
}
