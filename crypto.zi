// Account and record cryptography for Mesh apps: re-exports SHA-256,
// HMAC-SHA-256, PBKDF2-HMAC-SHA-256, ChaCha20-Poly1305, XChaCha20-Poly1305,
// and secure wiping from the reusable Ziran crypto package.
using CryptoSha256 :: #import "crypto/sha256";
CryptoChaCha :: #import "crypto/chacha20";
CryptoKdf :: #import "crypto/kdf";
CryptoWipe :: #import "crypto/wipe";

#program_export
Sha256 :: (data: *u8, length: s64, output: *u8) {
    CryptoSha256.Sha256(data, length, output)
}

#program_export
BytesToHex :: (bytes: *u8, length: s64,
    output: *u8, output_size: s64) -> s32 {
    return CryptoSha256.BytesToHex(bytes, length, output, output_size)
}

#program_export
HexToBytes :: (hex: string, output: *u8, output_size: s64) -> s32 {
    return CryptoSha256.HexToBytes(hex, output, output_size)
}

#program_export
Sha256Hex :: (data: *u8, length: s64, output: *u8) {
    CryptoSha256.Sha256Hex(data, length, output)
}

#program_export
HmacSha256 :: (key: *u8, key_length: s64,
    data: *u8, data_length: s64, output: *u8) -> s32 {
    return CryptoSha256.HmacSha256(key, key_length, data, data_length, output)
}

#program_export
HmacSha256Text :: (key: *u8, key_length: s64,
    data: string, output: *u8) -> s32 {
    return CryptoSha256.HmacSha256Text(key, key_length, data, output)
}

// Legacy PBKDF2-HMAC-SHA-256 for ksync-account-key-v2 compatibility:
// historical v2 exports truncated salt inputs to 32 bytes. Uses the fast
// precomputed-midstate implementation from crypto/kdf.
Pbkdf2Legacy :: (password: *u8, password_length: s64,
    password_text: string, use_text: bool,
    salt: *u8, salt_length: s64, iterations: u64, output: *u8) -> s32 {
    if output == null || iterations == 0 || iterations > 100000000 ||
        password_length < 0 || salt_length < 0 ||
        (!use_text && password == null && password_length > 0) ||
        (salt == null && salt_length > 0) {
        return 0
    }
    used := ifx salt_length > 32 then cast(s64)32 else salt_length
    if !use_text {
        return CryptoKdf.Pbkdf2Sha256Pointer(password, password_length, salt, used, iterations, output)
    }
    state: CryptoSha256.HmacSha256State
    defer CryptoSha256.HmacSha256Wipe(*state)
    CryptoSha256.HmacSha256PrepareText(*state, password_text)
    salt_block: [36]u8 = .[0]
    u: [32]u8
    t: [32]u8
    defer {
        CryptoWipe.SecureWipe(salt_block[:])
        CryptoWipe.SecureWipe(u[:])
        CryptoWipe.SecureWipe(t[:])
    }
    index: s64 = 0
    while index < used {
        salt_block[index] = salt[index]
        index += 1
    }
    salt_block[used + 3] = 1
    CryptoSha256.HmacSha256Compute(*state, *salt_block[0], used + 4, *u[0])
    for i: 0..31 { t[i] = u[i] }
    round: u64 = 1
    while round < iterations {
        CryptoSha256.HmacSha256Compute(*state, *u[0], 32, *u[0])
        for i: 0..31 { t[i] ^= u[i] }
        round += 1
    }
    for i: 0..31 { output[i] = t[i] }
    return 1
}

#program_export
Pbkdf2Sha256 :: (password: *u8, password_length: s64,
    salt: *u8, salt_length: s64, iterations: u64, output: *u8) -> s32 {
    return Pbkdf2Legacy(password, password_length, "", false,
        salt, salt_length, iterations, output)
}

#program_export
Pbkdf2Sha256Text :: (password: string, salt: *u8,
    salt_length: s64, iterations: u64, output: *u8) -> s32 {
    return Pbkdf2Legacy(null, password.count, password, true,
        salt, salt_length, iterations, output)
}

// Full-salt PBKDF2-HMAC-SHA-256 (no 32-byte truncation) for v3 key files.
Pbkdf2Sha256TextFull :: (password: string, salt: []u8, iterations: u64, output: []u8) -> bool {
    if output.count != 32 || iterations == 0 || iterations > 100000000 ||
        salt.count < 0 || salt.count > 1024 {
        return false
    }
    state: CryptoSha256.HmacSha256State
    defer CryptoSha256.HmacSha256Wipe(*state)
    CryptoSha256.HmacSha256PrepareText(*state, password)
    salt_block: [1028]u8 = .[0]
    u: [32]u8
    t: [32]u8
    defer {
        CryptoWipe.SecureWipe(salt_block[:])
        CryptoWipe.SecureWipe(u[:])
        CryptoWipe.SecureWipe(t[:])
    }
    for index: cast(s64)0..salt.count - 1 {
        salt_block[index] = salt[index]
    }
    salt_block[salt.count + 3] = 1
    CryptoSha256.HmacSha256Compute(*state, *salt_block[0], salt.count + 4, *u[0])
    for i: 0..31 { t[i] = u[i] }
    round: u64 = 1
    while round < iterations {
        CryptoSha256.HmacSha256Compute(*state, *u[0], 32, *u[0])
        for i: 0..31 { t[i] ^= u[i] }
        round += 1
    }
    for i: 0..31 { output[i] = t[i] }
    return true
}

#program_export
ChaCha20Poly1305Seal :: (key: *u8, nonce: *u8,
    plain: *u8, plain_length: s64, aad: *u8, aad_length: s64,
    output: *u8, output_capacity: s64) -> s32 {
    return CryptoChaCha.ChaCha20Poly1305Seal(key, nonce, plain, plain_length,
        aad, aad_length, output, output_capacity)
}

#program_export
ChaCha20Poly1305Open :: (key: *u8, nonce: *u8,
    sealed: *u8, sealed_length: s64, aad: *u8, aad_length: s64,
    plain: *u8, plain_capacity: s64) -> s32 {
    return CryptoChaCha.ChaCha20Poly1305Open(key, nonce, sealed, sealed_length,
        aad, aad_length, plain, plain_capacity)
}

#program_export
XChaCha20Poly1305Seal :: (key: *u8, nonce: *u8,
    plain: *u8, plain_length: s64, aad: *u8, aad_length: s64,
    output: *u8, output_capacity: s64) -> s32 {
    return CryptoChaCha.XChaCha20Poly1305Seal(key, nonce, plain, plain_length,
        aad, aad_length, output, output_capacity)
}

#program_export
XChaCha20Poly1305Open :: (key: *u8, nonce: *u8,
    sealed: *u8, sealed_length: s64, aad: *u8, aad_length: s64,
    plain: *u8, plain_capacity: s64) -> s32 {
    return CryptoChaCha.XChaCha20Poly1305Open(key, nonce, sealed, sealed_length,
        aad, aad_length, plain, plain_capacity)
}
